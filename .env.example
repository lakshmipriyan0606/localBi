# -----------------------------------------------------------------------------
# localBi — Environment Variables Reference (.env.example)
# NEVER commit actual secrets to version control.
# Copy this file to .env and populate with strong, unique credentials.
# -----------------------------------------------------------------------------

# Application Runtime
NODE_ENV=development
APP_NAME=localbi
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000
PORT=3000

# PostgreSQL Container Bootstrap (used only by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<STRONG_POSTGRES_ROOT_PASSWORD>
POSTGRES_DB=localbi
MIGRATOR_PASSWORD=<STRONG_MIGRATOR_PASSWORD>
APP_PASSWORD=<STRONG_APP_PASSWORD>

# Database Configuration (PostgreSQL 16)
# localbi_app: Restricted application runtime role (NOBYPASSRLS, NOSUPERUSER)
# connection_limit: tune to (max_pg_connections / num_next_instances) — e.g. 20 for 1 instance
# pool_timeout: seconds to wait for a free connection before erroring (default: 10)
DATABASE_URL=postgresql://localbi_app:<STRONG_APP_PASSWORD>@127.0.0.1:5432/localbi?schema=public&connection_limit=20&pool_timeout=10

# localbi_migrator: Table owner role, strictly for running schema migrations
MIGRATOR_DATABASE_URL=postgresql://localbi_migrator:<STRONG_MIGRATOR_PASSWORD>@127.0.0.1:5432/localbi?schema=public
DIRECT_URL=postgresql://localbi_migrator:<STRONG_MIGRATOR_PASSWORD>@127.0.0.1:5432/localbi?schema=public

# Redis Configuration (Queue & Cache with password authentication)
REDIS_PASSWORD=<STRONG_REDIS_PASSWORD>
REDIS_QUEUE_URL=redis://:<STRONG_REDIS_PASSWORD>@127.0.0.1:6379/0
REDIS_CACHE_URL=redis://:<STRONG_REDIS_PASSWORD>@127.0.0.1:6379/1

# Session & Security
# 32-byte hexadecimal string (64 chars) for session HMAC signing
SESSION_SECRET=<64_CHAR_HEX_SESSION_SECRET>
# 32-byte hexadecimal string (64 chars) for AES-256-GCM envelope encryption at rest
ENCRYPTION_MASTER_KEY=<64_CHAR_HEX_MASTER_KEY>
ENCRYPTION_KEY_ID=key-2026-v1

# Google OAuth 2.0 Integration (Tenant Connection Flow)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Feature Flags
ENABLE_GBP_SYNC=false
ENABLE_REGISTRATION=true

# Observability
LOG_LEVEL=info
