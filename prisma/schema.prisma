  @@unique([tenantId, brandId, productId], name: "uq_merchant_prod_mapping_brand")
  @@unique([tenantId, merchantAccountId, offerId], name: "uq_merchant_account_offer_id")
  @@index([tenantId, brandId, syncStatus], name: "idx_merchant_prod_mapping_status")
  @@map("merchant_product_mappings")
}

model MerchantLocalInventoryState {
  id                    String                 @id @default(cuid())
  tenantId              String                 @map("tenant_id")
  brandId               String                 @map("brand_id")
  storeId               String                 @map("store_id")
  productId             String                 @map("product_id")
  mappingId             String                 @map("mapping_id")
  storeCode             String                 @map("store_code")
  submittedPrice        Decimal                @map("submitted_price") @db.Decimal(10, 2)
  submittedCurrency     String                 @default("INR") @map("submitted_currency")
  submittedAvailability String                 @map("submitted_availability") // in_stock, out_of_stock, limited_availability, on_display_to_order
  submittedQuantity     Int?                   @map("submitted_quantity")
  syncStatus            String                 @default("QUEUED") @map("sync_status") // QUEUED, SYNCING, SYNCED, ERROR, REMOVED
  providerStatus        String?                @map("provider_status")
  payloadHash           String?                @map("payload_hash")
  lastSubmittedAt       DateTime?              @map("last_submitted_at")
  lastCheckedAt         DateTime?              @map("last_checked_at")
  lastError             String?                @map("last_error")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand                 Brand                  @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  store                 Location               @relation(fields: [tenantId, brandId, storeId], references: [tenantId, brandId, id], onDelete: Cascade)
  product               Product                @relation(fields: [tenantId, brandId, productId], references: [tenantId, brandId, id], onDelete: Cascade)
  mapping               MerchantProductMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storeId, productId], name: "uq_merchant_local_inventory_store_prod")
  @@unique([tenantId, brandId, storeId, productId], name: "uq_merchant_local_inventory_tenant_brand_store_prod")
  @@index([tenantId, storeId, syncStatus], name: "idx_merchant_local_inv_store_status")
  @@index([tenantId, brandId, syncStatus], name: "idx_merchant_local_inv_brand_status")
  @@map("merchant_local_inventory_states")
}

model MerchantProductIssue {
  id             String                 @id @default(cuid())
  tenantId       String                 @map("tenant_id")
  brandId        String                 @map("brand_id")
  mappingId      String                 @map("mapping_id")
  productId      String                 @map("product_id")
  storeId        String?                @map("store_id") // Null for global product issues, storeId for local inventory issues
  code           String                 // e.g. "missing_gtin", "price_mismatch", "image_link_broken"
  severity       String                 // INFO, WARNING, ERROR, DISAPPROVAL
  attributeName  String?                @map("attribute_name")
  message        String                 // Descriptive message
  detail         String?                // Technical detail or resolution guide
  firstSeenAt    DateTime               @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime               @default(now()) @map("last_seen_at")
  resolvedAt     DateTime?              @map("resolved_at")
  isResolved     Boolean                @default(false) @map("is_resolved")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand          Brand                  @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  mapping        MerchantProductMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  product        Product                @relation(fields: [tenantId, brandId, productId], references: [tenantId, brandId, id], onDelete: Cascade)
  store          Location?              @relation(fields: [tenantId, brandId, storeId], references: [tenantId, brandId, id], onDelete: Cascade)

  @@unique([tenantId, mappingId, code, storeId], name: "uq_merchant_prod_issue")
  @@index([tenantId, mappingId, isResolved], name: "idx_merchant_issue_resolved")
  @@index([tenantId, brandId, severity], name: "idx_merchant_issue_severity")
  @@map("merchant_product_issues")
}

// =============================================================================
// TELEPHONY & CALL ATTRIBUTION (Phase 9)
// =============================================================================

model VirtualNumber {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  brandId          String    @map("brand_id")
  storeId          String?   @map("store_id")
  webSurfaceId     String?   @map("web_surface_id")
  provider         String    // TWILIO, EXOTEL, TEST_ADAPTER, MANUAL
  providerNumberId String?   @map("provider_number_id")
  phoneNumber      String    @map("phone_number") // Normalized E.164 (e.g. +914441234567)
  countryCode      String    @default("IN") @map("country_code")
  forwardingNumber String?   @map("forwarding_number") // Destination phone number (real store phone)
  status           String    @default("AVAILABLE") // AVAILABLE, PROVISIONING, ACTIVE, SUSPENDED, RELEASE_PENDING, RELEASED, ERROR
  capabilities     Json?     // voice, sms
  createdAt        DateTime  @default(now()) @map("created_at")
  activatedAt      DateTime? @map("activated_at")
  releasedAt       DateTime? @map("released_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand            Brand       @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  store            Location?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  webSurface       WebSurface? @relation(fields: [webSurfaceId], references: [id], onDelete: SetNull)
  calls            Call[]

  @@unique([tenantId, id], name: "uq_virtual_number_tenant_id")
  @@unique([tenantId, phoneNumber], name: "uq_virtual_number_phone")
  @@index([tenantId, brandId, status], name: "idx_vnumber_brand_status")
  @@index([tenantId, storeId, status], name: "idx_vnumber_store_status")
  @@map("virtual_numbers")
}

model Call {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  brandId               String    @map("brand_id")
  storeId               String?   @map("store_id")
  webSurfaceId          String?   @map("web_surface_id")
  pageId                String?   @map("page_id")
  productId             String?   @map("product_id")
  virtualNumberId       String    @map("virtual_number_id")
  provider              String    // TWILIO, EXOTEL, TEST_ADAPTER, MANUAL
  providerCallId        String    @map("provider_call_id") // Provider's Call SID / ID
  direction             String    @default("INBOUND") // INBOUND
  callerNumber          String?   @map("caller_number") // E.164 caller phone (PII)
  callerNumberMasked    String?   @map("caller_number_masked") // Masked for non-PII roles (e.g. +91 ******1234)
  destinationNumber     String?   @map("destination_number") // Forwarded destination
  status                String    // INITIATED, RINGING, ANSWERED, COMPLETED, MISSED, BUSY, FAILED, CANCELLED
  startedAt             DateTime  @default(now()) @map("started_at")
  answeredAt            DateTime? @map("answered_at")
  endedAt               DateTime? @map("ended_at")
  durationSeconds       Int       @default(0) @map("duration_seconds")
  talkDurationSeconds   Int       @default(0) @map("talk_duration_seconds")
  recordingUrl          String?   @map("recording_url") // Protected provider recording reference
  attributionConfidence String    @default("STORE_NUMBER") @map("attribution_confidence") // STORE_NUMBER, SESSION_DNI, CALL_CLICK_CORRELATED, DIRECT, UNKNOWN
  source                String?   // google_organic, direct, google_ads, gbp
  medium                String?
  campaign              String?
  attributionSessionId  String?   @map("attribution_session_id")
  leadId                String?   @map("lead_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand                 Brand          @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  store                 Location?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  webSurface            WebSurface?    @relation(fields: [webSurfaceId], references: [id], onDelete: SetNull)
  virtualNumber         VirtualNumber  @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)
  lead                  Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  events                CallEvent[]

  @@unique([tenantId, id], name: "uq_call_tenant_id")
  @@unique([tenantId, provider, providerCallId], name: "uq_call_provider_call_id")
  @@index([tenantId, brandId, startedAt], name: "idx_calls_brand_started")
  @@index([tenantId, storeId, startedAt], name: "idx_calls_store_started")
  @@index([tenantId, status, startedAt], name: "idx_calls_status_started")
  @@map("calls")
}

model CallEvent {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  callId          String   @map("call_id")
  provider        String
  providerEventId String   @map("provider_event_id") // Provider's unique event/sequence ID
  eventType       String   @map("event_type") // initiated, ringing, answered, completed, hangup, etc.
  occurredAt      DateTime @default(now()) @map("occurred_at")
  payloadHash     String   @map("payload_hash") // SHA-256 for idempotency
  details         Json?    // Normalized non-PII details
  createdAt       DateTime @default(now()) @map("created_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  call            Call     @relation(fields: [tenantId, callId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id], name: "uq_call_event_tenant_id")
  @@unique([tenantId, provider, providerEventId], name: "uq_call_event_provider_event")
  @@index([tenantId, callId, occurredAt], name: "idx_call_events_call_occurred")
  @@map("call_events")
}

// =============================================================================
// KEYWORD INTELLIGENCE & SEO OPPORTUNITY ENGINE (Phase 10)
// Factual Signals + Explainable Recommendations + Transparent Prioritization
// =============================================================================

model Opportunity {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  brandId          String    @map("brand_id")
  storeId          String?   @map("store_id")
  webSurfaceId     String?   @map("web_surface_id")
  pageId           String?   @map("page_id")
  productId        String?   @map("product_id")
  categoryId       String?   @map("category_id")
  keywordId        String?   @map("keyword_id")

  type             String    // HIGH_IMPRESSIONS_LOW_CTR, HIGH_DEMAND_LOW_RANK, HIGH_CONVERSION_LOW_VISIBILITY, PAGE_WITH_TRAFFIC_NO_CONVERSIONS, MISSING_LANDING_PAGE, GBP_PROFILE_INCOMPLETE, UNANSWERED_REVIEWS, MERCHANT_PRODUCT_ISSUE, LOCAL_RANK_DECLINE, SEARCH_DEMAND_GROWTH, NAP_MISMATCH, DUPLICATE_LISTING
  status           String    @default("OPEN") // OPEN, IN_REVIEW, ACCEPTED, DISMISSED, COMPLETED, STALE
  priority         String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  priorityScore    Float     @default(0.0) @map("priority_score")
  confidence       String    @default("MEDIUM") // HIGH, MEDIUM, LOW

  title            String
  summary          String    @db.Text
  actionType       String    @map("action_type") // UPDATE_METADATA, IMPROVE_EXISTING_PAGE, CREATE_PAGE, ADD_PRODUCT_TO_STORE, FIX_GBP_PROFILE, RESPOND_TO_REVIEWS, FIX_MERCHANT_PRODUCT, INVESTIGATE_RANK_DECLINE, IMPROVE_CTA, ADD_KEYWORD_TRACKING
  actionPayload    Json?     @map("action_payload")

  ruleId           String    @map("rule_id")
  ruleVersion      String    @default("1.0.0") @map("rule_version")
  identityHash     String    @map("identity_hash")

  detectedAt       DateTime  @default(now()) @map("detected_at")
  lastEvaluatedAt  DateTime  @default(now()) @map("last_evaluated_at")
  resolvedAt       DateTime? @map("resolved_at")
  dismissedAt      DateTime? @map("dismissed_at")
  dismissalReason  String?   @map("dismissal_reason")
  dismissedBy      String?   @map("dismissed_by")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedBy       String?   @map("accepted_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand            Brand      @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  store            Location?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  webSurface       WebSurface? @relation(fields: [webSurfaceId], references: [id], onDelete: SetNull)
  page             Page?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  product          Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  category         Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  keyword          Keyword?   @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  evidence         OpportunityEvidence[]
  briefs           ContentBrief[]

  @@unique([tenantId, id], name: "uq_opportunity_tenant_id")
  @@unique([tenantId, identityHash], name: "uq_opportunity_identity_hash")
  @@index([tenantId, brandId, status, priorityScore(sort: Desc)], name: "idx_opp_brand_status_priority")
  @@index([tenantId, storeId, status], name: "idx_opp_store_status")
  @@index([tenantId, type, status], name: "idx_opp_type_status")
  @@map("opportunities")
}

model OpportunityEvidence {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  opportunityId    String    @map("opportunity_id")
  source           String    // GSC, GBP, LOCAL_RANK, GA4, LOCALBI, MERCHANT
  metric           String    // impressions, clicks, ctr, average_position, top3_coverage, top10_coverage, average_rank, conversions, call_count, unanswered_reviews, etc.
  value            Float
  comparisonValue  Float?    @map("comparison_value")
  formattedValue   String?   @map("formatted_value")
  dateRange        String?   @map("date_range")
  entityType       String?   @map("entity_type") // KEYWORD, PAGE, LOCATION, PRODUCT
  entityId         String?   @map("entity_id")
  entityLabel      String?   @map("entity_label")
  details          Json?
  capturedAt       DateTime  @default(now()) @map("captured_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity      Opportunity @relation(fields: [tenantId, opportunityId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id], name: "uq_opportunity_evidence_tenant_id")
  @@index([tenantId, opportunityId], name: "idx_opp_evidence_opportunity")
  @@map("opportunity_evidence")
}

