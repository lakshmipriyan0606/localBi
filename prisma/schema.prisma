model PageTemplate {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  brandId         String                @map("brand_id")
  webSurfaceId    String                @map("web_surface_id")
  name            String
  type            String                @default("STORE") // HOME, CITY, STORE, CATEGORY, PRODUCT, STORE_PRODUCT, CUSTOM
  status          String                @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  activeVersionId String?               @map("active_version_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand           Brand                 @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
