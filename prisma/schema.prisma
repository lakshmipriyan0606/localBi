  versions        PageTemplateVersion[]
  pages           Page[]

  @@unique([tenantId, id], name: "uq_page_template_tenant_id")
  @@unique([tenantId, brandId, webSurfaceId, type, name], name: "uq_page_template_unique")
  @@index([tenantId, brandId, webSurfaceId, type], name: "idx_page_templates_lookup")
