model MerchantProductMapping {
  id                   String                       @id @default(cuid())
  tenantId             String                       @map("tenant_id")
  brandId              String                       @map("brand_id")
  productId            String                       @map("product_id")
  merchantAccountId    String                       @map("merchant_account_id")
  offerId              String                       @map("offer_id") // Stable identifier (e.g. sku)
  targetCountry        String                       @default("IN") @map("target_country")
  contentLanguage      String                       @default("en") @map("content_language")
  feedLabel            String?                      @map("feed_label")
  channel              String                       @default("online_and_local") // online, local, online_and_local
  syncStatus           String                       @default("NOT_ENABLED") @map("sync_status") // NOT_ENABLED, QUEUED, SYNCING, SUBMITTED, PROCESSING, APPROVED, DISAPPROVED, ERROR, STALE, REMOVAL_PENDING, REMOVED
  providerStatus       String?                      @map("provider_status") // approved, disapproved, pending
  payloadHash          String?                      @map("payload_hash") // SHA-256 for change detection
  submittedPrice       Decimal?                     @map("submitted_price") @db.Decimal(10, 2)
  submittedCurrency    String?                      @map("submitted_currency")
  lastSubmittedAt      DateTime?                    @map("last_submitted_at")
  lastSuccessfulSyncAt DateTime?                    @map("last_successful_sync_at")
  lastCheckedAt        DateTime?                    @map("last_checked_at")
  lastError            String?                      @map("last_error")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand                Brand                        @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  product              Product                      @relation(fields: [tenantId, brandId, productId], references: [tenantId, brandId, id], onDelete: Cascade)
