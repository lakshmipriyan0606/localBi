datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// CONTROL PLANE (Global / Identity / Memberships)
// -----------------------------------------------------------------------------

model Tenant {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  timezone             String              @default("UTC")
  plan                 String              @default("STANDARD")
  status               String              @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_DELETION
  deletionScheduledAt  DateTime?           @map("deletion_scheduled_at")
  contactEmail         String?             @map("contact_email")
  industry             String?
  website              String?
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  memberships          TenantMembership[]
  invitations          Invitation[]
  brands               Brand[]
  locations            Location[]
  products             Product[]
  productLocations     ProductLocation[]
  connections          IntegrationConnection[]
  externalAccounts     ExternalAccount[]
  externalResources    ExternalResource[]
  resourceMappings     InternalResourceMapping[]
  gscProperties        GscProperty[]
  gscPages             GscPage[]
  gscQueries           GscQuery[]
  gscDailyTotals       GscDailyPropertyTotal[]
  gscDailyDevices      GscDailyDeviceMetric[]
  gscDailyCountries    GscDailyCountryMetric[]
  gscDailyPages        GscDailyPageMetric[]
  gscDailyQueries      GscDailyQueryMetric[]
  gbpDailyMetrics      GbpDailyMetric[]
  gbpReviews           GbpReview[]
  gbpLocationAggregates GbpLocationAggregate[]
  gbpPosts             GbpPost[]
  gbpMedia             GbpMedia[]
  syncRuns             SyncRun[]
  syncCursors          SyncCursor[]
  auditLogs            AuditLog[]
  microsites           Microsite[]
  micrositeVisitors    MicrositeVisitor[]
  categories           Category[]
  storeProducts        StoreProduct[]
  productMedia         ProductMedia[]
  webSurfaces          WebSurface[]
  domains              Domain[]
  brandThemes          BrandTheme[]
  pageTemplates        PageTemplate[]
  pageTemplateVersions PageTemplateVersion[]
  pages                Page[]
  seoConfigs           SeoConfig[]
  ga4DailyMetrics      Ga4DailyMetric[]

  @@map("tenants")
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  fullName         String              @map("full_name")
  status           String              @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  emailVerifiedAt  DateTime?           @map("email_verified_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  credential       UserCredential?
  identities       UserIdentity[]
  sessions         UserSession[]
  tokens           AuthToken[]
  memberships      TenantMembership[]
  staffAccess      PlatformStaffAccess[]

  @@map("users")
}

model UserCredential {
  userId               String    @id @map("user_id")
  passwordHash         String    @map("password_hash")
  passwordChangedAt    DateTime  @default(now()) @map("password_changed_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserIdentity {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  provider      String   // e.g. GOOGLE_SSO, OKTA, AZURE_AD
  providerSub   String   @map("provider_sub")
  providerEmail String   @map("provider_email")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub], name: "uq_user_identity_provider_sub")
  @@map("user_identities")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  sessionTokenHash String    @unique @map("session_token_hash")
  ipAddress        String    @map("ip_address")
  userAgent        String    @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_user_sessions_user_id")
  @@index([expiresAt], name: "idx_user_sessions_expires_at")
  @@map("user_sessions")
}

model AuthToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  tokenType  String    @map("token_type") // VERIFY_EMAIL, RESET_PASSWORD
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType], name: "idx_auth_tokens_user_type")
  @@index([expiresAt], name: "idx_auth_tokens_expires_at")
  @@map("auth_tokens")
}

model Invitation {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  email               String
  role                String
  scopeMode           String    @default("ALL") @map("scope_mode") // ALL, RESTRICTED
  invitedBrandIds     String[]  @default([]) @map("invited_brand_ids")
  invitedLocationIds  String[]  @default([]) @map("invited_location_ids")
  tokenHash           String    @unique @map("token_hash")
  invitedBy           String    @map("invited_by")
  expiresAt           DateTime  @map("expires_at")
  acceptedAt          DateTime? @map("accepted_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email], name: "idx_invitations_tenant_email")
  @@index([expiresAt], name: "idx_invitations_expires_at")
  @@map("invitations")
}

model PlatformStaffAccess {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  role           String    // SUPER_ADMIN, SUPPORT_ADMIN
  targetTenantId String    @map("target_tenant_id")
  reason         String
  approvedBy     String    @map("approved_by")
  startsAt       DateTime  @default(now()) @map("starts_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_staff_access")
}

model TenantMembership {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  role        String    // CLIENT_OWNER, CLIENT_ADMIN, BRAND_MANAGER, LOCATION_MANAGER, ANALYST, VIEWER
  scopeMode   String    @default("ALL") @map("scope_mode") // ALL, RESTRICTED
  status      String    @default("ACTIVE") // ACTIVE, SUSPENDED
  suspendedAt DateTime? @map("suspended_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandScopes    BrandAccessScope[]
  locationScopes LocationAccessScope[]

  @@unique([tenantId, userId], name: "uq_membership_tenant_user")
  @@unique([tenantId, id], name: "uq_membership_tenant_id")
  @@index([tenantId, status], name: "idx_tenant_memberships_tenant_status")
  @@map("tenant_memberships")
}

// -----------------------------------------------------------------------------
// TENANT DATA PLANE (Scoped by tenant_id)
// -----------------------------------------------------------------------------

model Brand {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  slug        String
  version     Int       @default(1)
  isArchived  Boolean   @default(false) @map("is_archived")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locations     Location[]
  products      Product[]
  categories    Category[]
  storeProducts StoreProduct[]
  scopes        BrandAccessScope[]
  webSurfaces   WebSurface[]
  domains       Domain[]
  theme         BrandTheme?
  pageTemplates    PageTemplate[]
  pages            Page[]
  seoConfigs       SeoConfig[]
  resourceMappings InternalResourceMapping[]
  ga4DailyMetrics  Ga4DailyMetric[]

  @@unique([tenantId, slug], name: "uq_brand_tenant_slug")
  @@unique([tenantId, id], name: "uq_brand_tenant_id")
  @@index([tenantId, isArchived, name], name: "idx_brands_tenant_archived_name")
  @@map("brands")
}

model BrandAccessScope {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  membershipId String   @map("membership_id")
  brandId      String   @map("brand_id")
  createdAt    DateTime @default(now()) @map("created_at")

  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  brand        Brand            @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, membershipId, brandId], name: "uq_brand_scope")
  @@map("brand_access_scopes")
}

model Location {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  brandId      String    @map("brand_id")
  name         String
  storeCode    String?   @map("store_code")
  addressLine1 String    @map("address_line1")
  city         String
  state        String
  postalCode   String    @map("postal_code")
  country      String    // ISO 3166-1 alpha-2 / alpha-3 (No hardcoded default)
  timezone     String    @default("UTC")
  version      Int       @default(1)
  isArchived   Boolean   @default(false) @map("is_archived")
  archivedAt   DateTime? @map("archived_at")
  isClosed     Boolean   @default(false) @map("is_closed")
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand        Brand     @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)

  scopes           LocationAccessScope[]
  storeProducts    StoreProduct[]
  productLocations ProductLocation[] // Deprecated: legacy composite mapping
  gbpMetrics       GbpDailyMetric[]
  gbpReviews       GbpReview[]
  gbpAggregate     GbpLocationAggregate?
  gbpPosts         GbpPost[]
  gbpMedia         GbpMedia[]
  pages            Page[]

  @@unique([tenantId, id], name: "uq_location_tenant_id")
  @@unique([tenantId, brandId, id], name: "uq_location_tenant_brand_id")
  @@unique([tenantId, brandId, storeCode], name: "uq_location_brand_code")
  @@index([tenantId, brandId, isArchived], name: "idx_locations_tenant_brand_archived")
  @@index([tenantId, storeCode], name: "idx_locations_tenant_store_code")
  @@map("locations")
}

model LocationAccessScope {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  membershipId String   @map("membership_id")
  locationId   String   @map("location_id")
  createdAt    DateTime @default(now()) @map("created_at")

  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  location     Location         @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, membershipId, locationId], name: "uq_location_scope")
  @@map("location_access_scopes")
}

model Category {
  id          String     @id @default(cuid())
  tenantId    String     @map("tenant_id")
  brandId     String     @map("brand_id")
  parentId    String?    @map("parent_id")
  name        String
  slug        String
  description String?    @db.Text
  sortOrder   Int        @default(0) @map("sort_order")
  status      String     @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand       Brand      @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  pages       Page[]

  @@unique([tenantId, id], name: "uq_category_tenant_id")
  @@unique([tenantId, brandId, id], name: "uq_category_tenant_brand_id")
  @@unique([tenantId, brandId, slug], name: "uq_category_tenant_brand_slug")
  @@index([tenantId, brandId, sortOrder], name: "idx_categories_brand_sort")
  @@index([tenantId, parentId], name: "idx_categories_parent")
  @@map("categories")
}

model Product {
  id               String            @id @default(cuid())
  tenantId         String            @map("tenant_id")
  brandId          String            @map("brand_id")
  categoryId       String?           @map("category_id")
  name             String
  slug             String            @default("")
  sku              String
  shortDescription String?           @map("short_description")
  description      String?           @db.Text
  basePrice        Decimal?          @map("base_price") @db.Decimal(10, 2)
  currency         String            @default("INR")
  status           String            @default("ACTIVE") // ACTIVE, INACTIVE
  publishStatus    String            @default("DRAFT") @map("publish_status") // DRAFT, PUBLISHED, UNPUBLISHED
  featured         Boolean           @default(false)
  category         String?           // Deprecated: legacy string category preserved for backward compatibility
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand            Brand             @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  categoryRel      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  storeProducts    StoreProduct[]
  media            ProductMedia[]
  productLocations ProductLocation[] // Deprecated: legacy composite mapping preserved
  pages            Page[]

  @@unique([tenantId, id], name: "uq_product_tenant_id")
  @@unique([tenantId, brandId, id], name: "uq_product_tenant_brand_id")
  @@unique([tenantId, brandId, sku], name: "uq_product_sku")
  @@unique([tenantId, brandId, slug], name: "uq_product_slug")
  @@index([tenantId, brandId, categoryId], name: "idx_products_brand_category")
  @@index([tenantId, brandId, status, publishStatus], name: "idx_products_brand_status")
  @@map("products")
}

model StoreProduct {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  brandId       String    @map("brand_id")
  storeId       String    @map("store_id")
  productId     String    @map("product_id")
  isAvailable   Boolean   @default(true) @map("is_available")
  priceOverride Decimal?  @map("price_override") @db.Decimal(10, 2)
  quantity      Int?      @default(0)
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand         Brand     @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  store         Location  @relation(fields: [tenantId, brandId, storeId], references: [tenantId, brandId, id], onDelete: Cascade)
  product       Product   @relation(fields: [tenantId, brandId, productId], references: [tenantId, brandId, id], onDelete: Cascade)

  @@unique([tenantId, id], name: "uq_store_product_tenant_id")
  @@unique([tenantId, brandId, id], name: "uq_store_product_tenant_brand_id")
  @@unique([storeId, productId], name: "uq_store_product_store_product")
  @@unique([tenantId, brandId, storeId, productId], name: "uq_store_product_tenant_brand_store_product")
  @@index([tenantId, brandId, storeId], name: "idx_store_products_store")
  @@index([tenantId, brandId, productId], name: "idx_store_products_product")
  @@index([tenantId, isAvailable], name: "idx_store_products_availability")
  @@map("store_products")
}

model ProductMedia {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  type      String   @default("IMAGE") // IMAGE, VIDEO
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id], name: "uq_product_media_tenant_id")
  @@index([tenantId, productId, sortOrder], name: "idx_product_media_product_sort")
  @@map("product_media")
}

// Deprecated: Kept strictly for backward compatibility with legacy references
model ProductLocation {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  brandId     String   @map("brand_id")
  productId   String   @map("product_id")
  locationId  String   @map("location_id")
  isAvailable Boolean  @default(true) @map("is_available")
  price       Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [tenantId, brandId, productId], references: [tenantId, brandId, id], onDelete: Cascade)
  location    Location @relation(fields: [tenantId, brandId, locationId], references: [tenantId, brandId, id], onDelete: Cascade)

  @@unique([tenantId, brandId, productId, locationId], name: "uq_product_location")
  @@map("product_locations")
}

// -----------------------------------------------------------------------------
// NORMALIZED GOOGLE INTEGRATION & RESOURCE DISCOVERY LAYER
// -----------------------------------------------------------------------------

model IntegrationConnection {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  provider              String    // GOOGLE
  externalSubjectId     String    @map("external_subject_id") // Google immutable sub
  externalEmail         String    @map("external_email")
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenKeyVersion       Int       @default(1) @map("token_key_version")
  grantedScopes         String[]  @map("granted_scopes")
  status                String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  lastUsedAt            DateTime? @map("last_used_at")
  revokedAt             DateTime? @map("revoked_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accounts              ExternalAccount[]
  resourceAccess        ConnectionResourceAccess[]

  @@unique([tenantId, id], name: "uq_connection_tenant_id")
  @@unique([tenantId, provider, externalSubjectId], name: "uq_connection_provider_sub")
  @@map("integration_connections")
}

model ExternalAccount {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  connectionId      String   @map("connection_id")
  provider          String   // GOOGLE_BUSINESS_PROFILE
  externalAccountId String   @map("external_account_id")
  accountName       String   @map("account_name")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection        IntegrationConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)

  resources         ExternalResource[]

  @@unique([tenantId, id], name: "uq_external_account_tenant_id")
  @@unique([tenantId, provider, externalAccountId], name: "uq_external_account_provider_id")
  @@map("external_accounts")
}

model ExternalResource {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  accountId          String   @map("account_id")
  provider           String   // GOOGLE_BUSINESS_PROFILE, GOOGLE_SEARCH_CONSOLE
  externalResourceId String   @map("external_resource_id")
  resourceType       String   @map("resource_type") // LOCATION, PROPERTY
  resourceName       String   @map("resource_name")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account            ExternalAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Cascade)

  connectionAccess   ConnectionResourceAccess[]
  internalMappings   InternalResourceMapping[]
  gscProperties      GscProperty[]

  @@unique([tenantId, id], name: "uq_external_resource_tenant_id")
  @@unique([tenantId, provider, externalResourceId], name: "uq_external_resource_provider_id")
  @@map("external_resources")
}

model ConnectionResourceAccess {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  connectionId   String   @map("connection_id")
  resourceId     String   @map("resource_id")
  canAccess      Boolean  @default(true) @map("can_access")
  lastVerifiedAt DateTime @default(now()) @map("last_verified_at")

  connection     IntegrationConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)
  resource       ExternalResource      @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, connectionId, resourceId], name: "uq_connection_resource_access")
  @@map("connection_resource_access")
}

model InternalResourceMapping {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  resourceId      String   @map("resource_id")
  internalType    String   @map("internal_type") // LOCATION, BRAND, WEBSURFACE
  internalId      String   @map("internal_id")
  brandId         String?  @map("brand_id")
  webSurfaceId    String?  @map("web_surface_id")
  filterStrategy  String   @default("NONE") @map("filter_strategy") // NONE, HOSTNAME, URL_PREFIX
  hostnameFilter  String?  @map("hostname_filter")
  urlPrefixFilter String?  @map("url_prefix_filter")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource        ExternalResource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade)
  brand           Brand?           @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  webSurface      WebSurface?      @relation(fields: [tenantId, webSurfaceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, internalType, internalId, resourceId], name: "uq_internal_resource_mapping")
  @@index([tenantId, webSurfaceId], name: "idx_resource_mapping_surface")
  @@index([tenantId, brandId], name: "idx_resource_mapping_brand")
  @@map("internal_resource_mappings")
}

// -----------------------------------------------------------------------------
// MULTI-GRAIN GSC ANALYTICS & DIMENSIONS
// -----------------------------------------------------------------------------

model GscProperty {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  resourceId   String   @map("resource_id")
  propertyUrl  String   @map("property_url") // e.g. sc-domain:example.com or https://example.com/
  propertyType String   @map("property_type") // DOMAIN, URL_PREFIX
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource     ExternalResource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade)

  pages        GscPage[]
  queries      GscQuery[]
  dailyTotals  GscDailyPropertyTotal[]
  dailyDevices GscDailyDeviceMetric[]
  dailyCountries GscDailyCountryMetric[]
