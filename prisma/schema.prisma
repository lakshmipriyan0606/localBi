  @@unique([tenantId, id], name: "uq_brand_theme_tenant_id")
  @@unique([tenantId, brandId], name: "uq_brand_theme_tenant_brand")
  @@map("brand_themes")
}

model PageTemplate {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  brandId         String                @map("brand_id")
  webSurfaceId    String                @map("web_surface_id")
  name            String
  type            String                @default("STORE") // HOME, CITY, STORE, CATEGORY, PRODUCT, STORE_PRODUCT, CUSTOM
  status          String                @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  activeVersionId String?               @map("active_version_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand           Brand                 @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  webSurface      WebSurface            @relation(fields: [tenantId, webSurfaceId], references: [tenantId, id], onDelete: Cascade)

  versions        PageTemplateVersion[]
  pages           Page[]

  @@unique([tenantId, id], name: "uq_page_template_tenant_id")
  @@unique([tenantId, brandId, webSurfaceId, type, name], name: "uq_page_template_unique")
  @@index([tenantId, brandId, webSurfaceId, type], name: "idx_page_templates_lookup")
  @@map("page_templates")
}

model PageTemplateVersion {
