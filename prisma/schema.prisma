  @@index([actorId, createdAt], name: "idx_audit_logs_actor_created")
  @@index([resourceType, resourceId], name: "idx_audit_logs_resource")
  @@map("audit_logs")
}

model GbpReview {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  locationId     String    @map("location_id")
  reviewId       String    @map("review_id")
  reviewerName   String    @map("reviewer_name")
  rating         Int
  comment        String?   @db.Text
  replyComment   String?   @db.Text
  replyUpdatedAt DateTime? @map("reply_updated_at")
  createTime     DateTime  @map("create_time")
  updateTime     DateTime  @map("update_time")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, reviewId], name: "uq_gbp_review")
  @@index([tenantId, locationId, updateTime(sort: Desc)], name: "idx_gbp_reviews_location_updated")
  @@index([tenantId, locationId, rating], name: "idx_gbp_reviews_location_rating")
  @@map("gbp_reviews")
}

model GbpLocationAggregate {
