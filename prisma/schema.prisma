  domains          Domain[]
  pageTemplates    PageTemplate[]
  pages            Page[]
  seoConfigs       SeoConfig[]
  resourceMappings InternalResourceMapping[]
  ga4DailyMetrics  Ga4DailyMetric[]

  @@unique([tenantId, id], name: "uq_web_surface_tenant_id")
  @@unique([tenantId, brandId, id], name: "uq_web_surface_tenant_brand_id")
  @@unique([tenantId, brandId, type], name: "uq_web_surface_tenant_brand_type")
  @@index([tenantId, brandId, status], name: "idx_web_surfaces_brand")
