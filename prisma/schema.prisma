  @@unique([tenantId, productId], name: "uq_product_merchant_config")
  @@unique([tenantId, brandId, productId], name: "uq_product_merchant_config_brand")
  @@index([tenantId, brandId, enabled], name: "idx_prod_merchant_cfg_enabled")
  @@map("product_merchant_configs")
