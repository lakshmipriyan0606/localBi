  storeId      String?      @map("store_id")
  categoryId   String?      @map("category_id")
  productId    String?      @map("product_id")
  status       String       @default("PUBLISHED") // PUBLISHED, DRAFT, UNPUBLISHED
  canonicalUrl String?      @map("canonical_url")
