  @@map("content_categories")
}

model ContentBrief {
  id                 String        @id @default(cuid())
  tenantId           String        @map("tenant_id")
  brandId            String        @map("brand_id")
  keywordId          String?       @map("keyword_id")
  opportunityId      String?       @map("opportunity_id")
  workingTitle       String        @map("working_title")
  primaryTopic       String        @map("primary_topic")
  primaryKeyword     String?       @map("primary_keyword")
  secondaryKeywords  Json?         @map("secondary_keywords")
  intent             String        @default("INFORMATIONAL") // INFORMATIONAL, COMMERCIAL, LOCAL, TRANSACTIONAL
  targetAudience     String?       @map("target_audience")
  relatedProductIds  Json?         @map("related_product_ids")
  relatedStoreIds    Json?         @map("related_store_ids")
  relatedCategoryIds Json?         @map("related_category_ids")
  requiredTopics     Json?         @map("required_topics")
  notes              String?       @db.Text
  status             String        @default("DRAFT") // DRAFT, READY, ASSIGNED, IN_PROGRESS, COMPLETED, DISCARDED
  createdBy          String?       @map("created_by")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand              Brand         @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  opportunity        Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  keyword            Keyword?      @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  contentItems       ContentItem[]

  @@unique([tenantId, id], name: "uq_content_brief_tenant_id")
  @@index([tenantId, brandId, status], name: "idx_content_briefs_status")
  @@index([tenantId, opportunityId], name: "idx_content_briefs_opportunity")
