  pageTemplate   PageTemplate @relation(fields: [pageTemplateId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id], name: "uq_page_template_version_tenant_id")
  @@unique([pageTemplateId, version], name: "uq_page_template_version")
  @@index([tenantId, pageTemplateId, status], name: "idx_page_template_versions_status")
  @@map("page_template_versions")
}

model Page {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  brandId      String       @map("brand_id")
  webSurfaceId String       @map("web_surface_id")
  templateId   String       @map("template_id")
  pageType     String       @default("STORE") @map("page_type") // HOME, CITY, STORE, CATEGORY, PRODUCT, STORE_PRODUCT, CUSTOM
  slug         String
  citySlug     String?      @map("city_slug")
  storeId      String?      @map("store_id")
  categoryId   String?      @map("category_id")
  productId    String?      @map("product_id")
  status       String       @default("PUBLISHED") // PUBLISHED, DRAFT, UNPUBLISHED
  canonicalUrl String?      @map("canonical_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  webSurface   WebSurface   @relation(fields: [tenantId, webSurfaceId], references: [tenantId, id], onDelete: Cascade)
  template     PageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  store        Location?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id], name: "uq_page_tenant_id")
  @@unique([tenantId, brandId, webSurfaceId, slug], name: "uq_page_slug")
  @@index([tenantId, webSurfaceId, pageType, slug], name: "idx_pages_resolution")
  @@index([tenantId, storeId], name: "idx_pages_store")
  @@index([tenantId, productId], name: "idx_pages_product")
  @@map("pages")
}

model SeoConfig {
  id                  String      @id @default(cuid())
  tenantId            String      @map("tenant_id")
  brandId             String      @map("brand_id")
  webSurfaceId        String?     @map("web_surface_id")
  pageType            String?     @map("page_type")
  titleTemplate       String      @map("title_template")
  descriptionTemplate String      @map("description_template")
  keywords            String?
  robotsPolicy        String      @default("index, follow") @map("robots_policy")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand               Brand       @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  webSurface          WebSurface? @relation(fields: [tenantId, webSurfaceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id], name: "uq_seo_config_tenant_id")
  @@unique([tenantId, brandId, webSurfaceId, pageType], name: "uq_seo_config_scope")
  @@index([tenantId, brandId, pageType], name: "idx_seo_configs_lookup")
  @@map("seo_configs")
}

model Ga4DailyMetric {
  id                 BigInt   @id @default(autoincrement())
  tenantId           String   @map("tenant_id")
  brandId            String   @map("brand_id")
  webSurfaceId       String   @map("web_surface_id")
  resourceId         String   @map("resource_id")
  date               DateTime @db.Date
  activeUsers        Int      @default(0) @map("active_users")
  newUsers           Int      @default(0) @map("new_users")
  sessions           Int      @default(0)
  engagedSessions    Int      @default(0) @map("engaged_sessions")
  eventCount         Int      @default(0) @map("event_count")
  keyEvents          Int      @default(0) @map("key_events")
  screenPageViews    Int      @default(0) @map("screen_page_views")
  avgEngagementTime  Float    @default(0.0) @map("avg_engagement_time")
  freshnessTimestamp DateTime @default(now()) @map("freshness_timestamp")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand              Brand      @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  webSurface         WebSurface @relation(fields: [tenantId, webSurfaceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, webSurfaceId, date, resourceId], name: "uq_ga4_daily_metric")
  @@index([tenantId, brandId, date], name: "idx_ga4_daily_metric_brand_date")
  @@map("ga4_daily_metrics")
}

