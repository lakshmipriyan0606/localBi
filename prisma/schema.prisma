  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand        Brand         @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)
  contentItems ContentItem[]

  @@unique([tenantId, id], name: "uq_content_author_tenant_id")
  @@unique([tenantId, brandId, slug], name: "uq_content_author_brand_slug")
