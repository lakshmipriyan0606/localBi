// -----------------------------------------------------------------------------
// MULTI-GRAIN GSC ANALYTICS & DIMENSIONS
// -----------------------------------------------------------------------------

model GscProperty {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  resourceId   String   @map("resource_id")
  propertyUrl  String   @map("property_url") // e.g. sc-domain:example.com or https://example.com/
  propertyType String   @map("property_type") // DOMAIN, URL_PREFIX
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource     ExternalResource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade)

  pages        GscPage[]
  queries      GscQuery[]
  dailyTotals  GscDailyPropertyTotal[]
  dailyDevices GscDailyDeviceMetric[]
  dailyCountries GscDailyCountryMetric[]
  dailyPages   GscDailyPageMetric[]
  dailyQueries GscDailyQueryMetric[]

  @@unique([tenantId, id], name: "uq_gsc_property_tenant_id")
  @@unique([tenantId, propertyUrl], name: "uq_gsc_property_url")
  @@map("gsc_properties")
}

model GscPage {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id")
  propertyId String   @map("property_id")
  pageHash   String   @db.Char(64) @map("page_hash") // SHA-256 of URL to avoid large B-Tree index bloat
  fullUrl    String   @map("full_url")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   GscProperty @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Cascade)

  dailyMetrics GscDailyPageMetric[]

  @@unique([tenantId, id], name: "uq_gsc_page_tenant_id")
  @@unique([tenantId, propertyId, pageHash], name: "uq_gsc_page_hash")
  @@map("gsc_pages")
}

model GscQuery {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id")
  propertyId String   @map("property_id")
  queryHash  String   @db.Char(64) @map("query_hash") // SHA-256 of query text
  queryText  String   @map("query_text")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   GscProperty @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Cascade)

  dailyMetrics GscDailyQueryMetric[]

  @@unique([tenantId, id], name: "uq_gsc_query_tenant_id")
  @@unique([tenantId, propertyId, queryHash], name: "uq_gsc_query_hash")
  @@map("gsc_queries")
}

model GscDailyPropertyTotal {
  id                     BigInt   @id @default(autoincrement())
  tenantId               String   @map("tenant_id")
  propertyId             String   @map("property_id")
  date                   DateTime @db.Date
  searchType             String   @default("WEB") @map("search_type")
  dataState              String   @default("FINAL") @map("data_state") // FINAL, FRESH
  clicks                 Int      @default(0)
  impressions            Int      @default(0)
  sumPositionImpressions Float    @default(0.0) @map("sum_position_impressions") // position * impressions
  syncRevision           Int      @default(1) @map("sync_revision")
  freshnessTimestamp     DateTime @map("freshness_timestamp")

  tenant                 Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property               GscProperty @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, propertyId, date, searchType], name: "uq_gsc_property_total")
  @@map("gsc_daily_property_totals")
}

model GscDailyDeviceMetric {
  id                     BigInt   @id @default(autoincrement())
  tenantId               String   @map("tenant_id")
  propertyId             String   @map("property_id")
  date                   DateTime @db.Date
  searchType             String   @default("WEB") @map("search_type")
  device                 String   // DESKTOP, MOBILE, TABLET
  clicks                 Int      @default(0)
  impressions            Int      @default(0)
  sumPositionImpressions Float    @default(0.0) @map("sum_position_impressions")

  tenant                 Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property               GscProperty @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, propertyId, date, searchType, device], name: "uq_gsc_device_metric")
  @@map("gsc_daily_device_metrics")
}

model GscDailyCountryMetric {
  id                     BigInt   @id @default(autoincrement())
  tenantId               String   @map("tenant_id")
  propertyId             String   @map("property_id")
  date                   DateTime @db.Date
  searchType             String   @default("WEB") @map("search_type")
  country                String   @db.Char(3) // ISO 3166-1 alpha-3
  clicks                 Int      @default(0)
  impressions            Int      @default(0)
  sumPositionImpressions Float    @default(0.0) @map("sum_position_impressions")

  tenant                 Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property               GscProperty @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, propertyId, date, searchType, country], name: "uq_gsc_country_metric")
  @@map("gsc_daily_country_metrics")
}

model GscDailyPageMetric {
  id                     BigInt   @id @default(autoincrement())
  tenantId               String   @map("tenant_id")
  propertyId             String   @map("property_id")
  date                   DateTime @db.Date
  searchType             String   @default("WEB") @map("search_type")
  pageId                 BigInt   @map("page_id")
  clicks                 Int      @default(0)
  impressions            Int      @default(0)
  sumPositionImpressions Float    @default(0.0) @map("sum_position_impressions")

  tenant                 Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property               GscProperty @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Cascade)
  page                   GscPage     @relation(fields: [tenantId, pageId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, propertyId, date, searchType, pageId], name: "uq_gsc_page_metric")
  @@map("gsc_daily_page_metrics")
}

model GscDailyQueryMetric {
  id                     BigInt   @id @default(autoincrement())
  tenantId               String   @map("tenant_id")
  propertyId             String   @map("property_id")
  date                   DateTime @db.Date
  searchType             String   @default("WEB") @map("search_type")
  queryId                BigInt   @map("query_id")
  clicks                 Int      @default(0)
  impressions            Int      @default(0)
  sumPositionImpressions Float    @default(0.0) @map("sum_position_impressions")

  tenant                 Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property               GscProperty @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Cascade)
  query                  GscQuery    @relation(fields: [tenantId, queryId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, propertyId, date, searchType, queryId], name: "uq_gsc_query_metric")
  @@map("gsc_daily_query_metrics")
}

// -----------------------------------------------------------------------------
