  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand           Brand    @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id], name: "uq_brand_theme_tenant_id")
  @@unique([tenantId, brandId], name: "uq_brand_theme_tenant_brand")
  @@map("brand_themes")
